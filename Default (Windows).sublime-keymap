        "keys": ["ctrl+shift+n"],
        "command": "normalize_whitespace"
    },
    {
        "keys": ["alt+t"],
        "command": "emacs_transpose_words"
    },
    {
        "keys": ["ctrl+shift+="], 
        "command": "evaluate_math"
    },
    {
        "keys": ["ctrl+shift+i"], 
        "command": "prompt_insert_sequence"
    },
    { 
        "keys": ["ctrl+alt+s"], 
        "command": "swap_panes" 
